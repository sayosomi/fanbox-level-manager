{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fanbox-level-portal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "secrets": {
    "required": ["SYNC_API_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fanbox-level-portal",
      "migrations_dir": "migrations"
    }
  ]
}
