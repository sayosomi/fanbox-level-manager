{
  "name": "@sayosomi/portal-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "generate-types": "wrangler types src/worker-configuration.d.ts",
    "types:check": "wrangler types src/worker-configuration.d.ts --check",
    "typecheck": "npm run types:check && tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "wrangler": "4.129.0"
  }
}
